		displayFolder: html_visuais
		lineageTag: a1b2c3d4-0006-4000-8000-000000000006

	/// Visual HTML: Controle de Meta Mercado Mãe com KPIs e Termômetro Visual
	measure html_vg_mercado_mae =
			VAR n_gasto = [gasto_mercado_mae_mes]
			VAR n_saldo = [saldo_mercado_mae]
			VAR n_teto = [orcamento_mercado_mae]
			VAR n_pct = [porcent_mercado_mae_mes]
			VAR v_gasto = FORMAT(n_gasto, """R$"" #,0.00;-""R$"" #,0.00;""R$"" 0.00", "pt-BR")
			VAR v_saldo = FORMAT(n_saldo, "+""R$"" #,0.00;-""R$"" #,0.00;""R$"" 0.00", "pt-BR")
			VAR v_acum = FORMAT([soma_mercado_mae], """R$"" #,0.00;-""R$"" #,0.00;""R$"" 0.00", "pt-BR")
			VAR v_media = FORMAT([media_mensal_mercado_mae], """R$"" #,0.00;-""R$"" #,0.00;""R$"" 0.00", "pt-BR")
			VAR v_ticket = FORMAT([ticket_medio_mercado_mae], """R$"" #,0.00;-""R$"" #,0.00;""R$"" 0.00", "pt-BR")
			VAR v_pct = FORMAT(n_pct, "0.0%", "pt-BR")
			VAR cor_status = IF(n_gasto > n_teto, "#FF4A53", IF(n_pct >= 0.85, "#D97706", "#10715A"))
			VAR escala_max = MAX(n_teto * 1.25, n_gasto * 1.05)
			VAR fill_num = MIN(MAX(DIVIDE(n_gasto, escala_max, 0) * 100, 0), 100)
			VAR w_fill = FORMAT(fill_num, "0.0", "en-US") & "%"
			VAR pos_teto = FORMAT(MIN(MAX(DIVIDE(n_teto, escala_max, 0) * 100, 0), 100), "0.0", "en-US") & "%"
			VAR txt_barra = v_gasto & " (" & v_pct & ")"
			VAR inner_bar = IF(fill_num >= 32, "<div class='mm-fill' style='width:" & w_fill & ";background:" & cor_status & ";'>" & txt_barra & "</div>", "<div class='mm-fill' style='width:" & w_fill & ";padding:0;background:" & cor_status & ";'></div><span style='font-size:9px;font-weight:700;color:#252321;padding-left:6px;white-space:nowrap;'>" & txt_barra & "</span>")
			VAR status_txt = IF(n_gasto > n_teto, "Teto ultrapassado", "Dentro da meta")
			RETURN
			[html_css_base] &
			"<div class='card sec' style='height:155px;padding:11px 16px 12px 16px;'>" &
			"<div class='sec-head'>" &
			"<div><div class='head-l'><span class='sq-md' style='background:#F99C3E;'></span><span class='sec-ttl'>CONTROLE DE META: MERCADO MÃE (SUBSÍDIO MENSAL R$ 500,00)</span></div><div class='sec-sub'>Monitoramento direto do teto mensal no cartão Flash, saldo remanescente, acumulado histórico e termômetro visual</div></div>" &
			"<span class='pill' style='background:#FEF3C7;color:#D97706;'>TETO R$ 500/MÊS</span>" &
			"</div>" &
			"<div class='mm-grid'>" &
			"<div class='sub-box'><span class='sub-lbl'>GASTO NO MÊS ATUAL</span><span class='sub-val' style='color:" & cor_status & ";'>" & v_gasto & "</span><span class='sub-meta' style='color:" & cor_status & ";'>" & v_pct & " do teto (" & status_txt & ")</span></div>" &
			"<div class='sub-box'><span class='sub-lbl'>SALDO DISPONÍVEL DA META</span><span class='sub-val' style='color:" & IF(n_saldo >= 0, "#10715A", "#FF4A53") & ";'>" & v_saldo & "</span><span class='sub-meta'>Orçamento Fixo: R$ 500,00</span></div>" &
			"<div class='sub-box'><span class='sub-lbl'>ACUMULADO HISTÓRICO</span><span class='sub-val'>" & v_acum & "</span><span class='sub-meta'>Média: " & v_media & " &bull; Ticket: " & v_ticket & "</span></div>" &
			"<div class='sub-box'>" &
			"<span class='sub-lbl'>TERMÔMETRO DE CONSUMO DO MÊS ATUAL VS TETO (R$ 500,00)</span>" &
			"<div class='mm-track' style='display:flex;align-items:center;'>" & inner_bar & "<div class='mm-limit' style='left:" & pos_teto & ";'></div></div>" &
			"<div class='mm-scale'><span>R$ 0</span><span>R$ 250 (50%)</span><span style='color:#D97706;font-weight:700;'>Limite R$ 500 (100%)</span></div>" &
			"</div>" &
			"</div></div>"
		displayFolder: html_visuais
		lineageTag: a1b2c3d4-0007-4000-8000-000000000007

	/// Visual HTML: KPI 1 de Investimentos (Total Aportado Histórico)
	measure html_inv_kpi_aportado =
			VAR v_ap = FORMAT([aportes_totais], """R$"" #,0.00;-""R$"" #,0.00;""R$"" 0.00", "pt-BR")
			VAR v_qtd = FORMAT(COALESCE([qtd_aportes], 0), "#,0", "pt-BR")
			RETURN
			[html_css_base] &
			"<div class='card kpi'>" &
			"<div class='kpi-bar' style='background:#10715A;'></div>" &
			"<div class='kpi-head'>" &
			"<div class='head-l'><span class='sq-sm' style='background:#10715A;'></span><span class='kpi-ttl'>TOTAL APORTADO (HISTÓRICO)</span></div>" &
			"<span class='pill' style='background:#DCFCE7;color:#10715A;'>APORTE BRUTO</span>" &
			"</div>" &
			"<div class='kpi-val-row'><span class='kpi-val' style='color:#3B89E2;'>" & v_ap & "</span></div>" &
			"<div class='kpi-sub'>Qtd. Aportes: " & v_qtd & " operações registradas</div>" &
			"</div>"
		displayFolder: html_visuais
		lineageTag: a1b2c3d4-0008-4000-8000-000000000008

	/// Visual HTML: KPI 2 de Investimentos (Total Resgatado de Aplicações)
	measure html_inv_kpi_resgatado =
			VAR v_resg = FORMAT([resgates_totais], """R$"" #,0.00;-""R$"" #,0.00;""R$"" 0.00", "pt-BR")
			VAR v_cdi = FORMAT([resgates_cdi], """R$"" #,0.00;-""R$"" #,0.00;""R$"" 0.00", "pt-BR")
			RETURN
			[html_css_base] &
			"<div class='card kpi'>" &
			"<div class='kpi-bar' style='background:#F99C3E;'></div>" &
