			"<div class='head-l'><span class='sq-sm' style='background:#F99C3E;'></span><span class='kpi-ttl'>TOTAL RESGATADO (APLICAÇÕES)</span></div>" &
			"<span class='pill' style='background:#FEF3C7;color:#D97706;'>SAQUES / LIQU.</span>" &
			"</div>" &
			"<div class='kpi-val-row'><span class='kpi-val' style='color:#D97706;'>" & v_resg & "</span></div>" &
			"<div class='kpi-sub'>Resgates CDI: " & v_cdi & " &bull; Sem vendas pessoais</div>" &
			"</div>"
		displayFolder: html_visuais
		lineageTag: a1b2c3d4-0009-4000-8000-000000000009

	/// Visual HTML: KPI 3 de Investimentos (Aporte Líquido Acumulado)
	measure html_inv_kpi_aporte_liquido =
			VAR v_liq = FORMAT([aporte_liquido_investimentos], """R$"" #,0.00;-""R$"" #,0.00;""R$"" 0.00", "pt-BR")
			VAR v_ret = FORMAT(DIVIDE([aporte_liquido_investimentos], [aportes_totais], 0), "0.0%", "pt-BR")
			RETURN
			[html_css_base] &
			"<div class='card kpi'>" &
			"<div class='kpi-bar' style='background:#3B89E2;'></div>" &
			"<div class='kpi-head'>" &
			"<div class='head-l'><span class='sq-sm' style='background:#3B89E2;'></span><span class='kpi-ttl'>APORTE LÍQUIDO ACUMULADO</span></div>" &
			"<span class='pill' style='background:#EFF6FF;color:#3B89E2;'>CAPITAL RETIDO</span>" &
			"</div>" &
			"<div class='kpi-val-row'><span class='kpi-val' style='color:#10715A;'>" & v_liq & "</span></div>" &
			"<div class='kpi-sub'>Taxa de retenção sobre aportes: " & v_ret & "</div>" &
			"</div>"
		displayFolder: html_visuais
		lineageTag: a1b2c3d4-0010-4000-8000-000000000010

	/// Visual HTML: KPI 4 de Investimentos (Patrimônio Ativo Estimado e Lucro nos Indexadores)
	measure html_inv_kpi_rentabilidade =
			VAR v_pat = FORMAT([patrimonio_investido_estimado], """R$"" #,0.00;-""R$"" #,0.00;""R$"" 0.00", "pt-BR")
			VAR n_lucro = [lucro_total_estimado]
			VAR v_lucro = FORMAT(n_lucro, "+""R$"" #,0.00;-""R$"" #,0.00;""R$"" 0.00", "pt-BR")
			VAR n_rent = [dif_rendido_cdi_porcent]
			VAR v_rent = FORMAT(n_rent, "+0.00%;-0.00%;0.00%", "pt-BR")
			RETURN
			[html_css_base] &
			"<div class='card kpi'>" &
			"<div class='kpi-bar' style='background:#10715A;'></div>" &
			"<div class='kpi-head'>" &
			"<div class='head-l'><span class='sq-sm' style='background:#10715A;'></span><span class='kpi-ttl'>PATRIMÔNIO ATIVO ESTIMADO</span></div>" &
			"<span class='pill' style='background:#DCFCE7;color:#10715A;'>DIM_CDI + USD</span>" &
			"</div>" &
			"<div class='kpi-val-row'><span class='kpi-val' style='color:#10715A;'>" & v_pat & "</span><span class='delta-pill' style='background:#10715A;'>" & v_rent & " CDI</span></div>" &
			"<div class='kpi-sub'>Lucro Est. (CDI + Câmbio): " & v_lucro & "</div>" &
			"</div>"
		displayFolder: html_visuais
		lineageTag: a1b2c3d4-0011-4000-8000-000000000011

	/// Visual HTML: Alocação por Ativo / Indexador com barras de progresso fiéis ao Figma
	measure html_inv_alocacao_ativos =
			VAR total_ap = COALESCE([aportes_totais], 0)
			VAR v_cdi = COALESCE(CALCULATE([aportes_totais], KEEPFILTERS(FAT_FINANCES[SUB_CATEGORY] = "CDI")), 0)
			VAR v_tes = COALESCE(CALCULATE([aportes_totais], KEEPFILTERS(FAT_FINANCES[SUB_CATEGORY] = "Tesouro Direto")), 0)
			VAR v_lci = COALESCE(CALCULATE([aportes_totais], KEEPFILTERS(FAT_FINANCES[SUB_CATEGORY] = "LCI")), 0)
			VAR v_fii = COALESCE(CALCULATE([aportes_totais], KEEPFILTERS(FAT_FINANCES[SUB_CATEGORY] IN { "FII's & ETF’s", "FII's / ETF’s", "FII's & ETF's", "FII's / ETF's" })), 0)
			VAR v_cry = COALESCE(CALCULATE([aportes_totais], KEEPFILTERS(FAT_FINANCES[SUB_CATEGORY] = "Crypto")), 0)
			VAR v_lca = COALESCE(CALCULATE([aportes_totais], KEEPFILTERS(FAT_FINANCES[SUB_CATEGORY] = "LCA")), 0)
			VAR v_out = MAX(total_ap - (v_cdi + v_tes + v_lci + v_fii + v_cry), 0)
			VAR p_cdi = DIVIDE(v_cdi, total_ap, 0)
			VAR p_tes = DIVIDE(v_tes, total_ap, 0)
			VAR p_lci = DIVIDE(v_lci, total_ap, 0)
			VAR p_fii = DIVIDE(v_fii, total_ap, 0)
			VAR p_cry = DIVIDE(v_cry, total_ap, 0)
			VAR p_out = DIVIDE(v_out, total_ap, 0)
			VAR pct_rf = FORMAT(DIVIDE(v_cdi + v_tes + v_lci + v_lca, total_ap, 0), "0.0%", "pt-BR")
			VAR pct_rv = FORMAT(DIVIDE(MAX(total_ap - (v_cdi + v_tes + v_lci + v_lca), 0), total_ap, 0), "0.0%", "pt-BR")
			RETURN
			[html_css_base] &
			"<div class='card sec' style='height:430px;'>" &
			"<div class='sec-head'>" &
			"<div><div class='head-l'><span class='sq-md' style='background:#3B89E2;'></span><span class='sec-ttl'>ALOCAÇÃO POR ATIVO / INDEXADOR</span></div><div class='sec-sub'>Volume total aportado por classe de ativo na carteira</div></div>" &
			"<span class='pill' style='background:#EFF6FF;color:#3B89E2;'>PORTFÓLIO</span>" &
			"</div>" &
			"<div class='div-line'></div>" &
			"<div class='alloc-list'>" &
			"<div class='alloc-row' style='opacity:" & IF(v_cdi > 0, "1", "0.45") & ";'><div class='alloc-top'><span class='alloc-name'>CDI (Porquinho Inter / CDB)</span><span class='alloc-nums'><span class='alloc-val'>" & FORMAT(v_cdi, """R$"" #,0.00", "pt-BR") & "</span><span class='alloc-pct'>(" & FORMAT(p_cdi, "0.0%", "pt-BR") & ")</span></span></div><div class='prog-track'><div class='prog-fill' style='width:" & FORMAT(MIN(p_cdi * 100, 100), "0.0", "en-US") & "%;background:#3B89E2;'></div></div></div>" &
			"<div class='alloc-row' style='opacity:" & IF(v_tes > 0, "1", "0.45") & ";'><div class='alloc-top'><span class='alloc-name'>Tesouro Direto (Selic / IPCA)</span><span class='alloc-nums'><span class='alloc-val'>" & FORMAT(v_tes, """R$"" #,0.00", "pt-BR") & "</span><span class='alloc-pct'>(" & FORMAT(p_tes, "0.0%", "pt-BR") & ")</span></span></div><div class='prog-track'><div class='prog-fill' style='width:" & FORMAT(MIN(p_tes * 100, 100), "0.0", "en-US") & "%;background:#1E3A5F;'></div></div></div>" &
			"<div class='alloc-row' style='opacity:" & IF(v_lci > 0, "1", "0.45") & ";'><div class='alloc-top'><span class='alloc-name'>LCI (Isento de IR)</span><span class='alloc-nums'><span class='alloc-val'>" & FORMAT(v_lci, """R$"" #,0.00", "pt-BR") & "</span><span class='alloc-pct'>(" & FORMAT(p_lci, "0.0%", "pt-BR") & ")</span></span></div><div class='prog-track'><div class='prog-fill' style='width:" & FORMAT(MIN(p_lci * 100, 100), "0.0", "en-US") & "%;background:#10715A;'></div></div></div>" &
			"<div class='alloc-row' style='opacity:" & IF(v_fii > 0, "1", "0.45") & ";'><div class='alloc-top'><span class='alloc-name'>FII's &amp; ETF's (Renda Passiva)</span><span class='alloc-nums'><span class='alloc-val'>" & FORMAT(v_fii, """R$"" #,0.00", "pt-BR") & "</span><span class='alloc-pct'>(" & FORMAT(p_fii, "0.0%", "pt-BR") & ")</span></span></div><div class='prog-track'><div class='prog-fill' style='width:" & FORMAT(MIN(p_fii * 100, 100), "0.0", "en-US") & "%;background:#F99C3E;'></div></div></div>" &
			"<div class='alloc-row' style='opacity:" & IF(v_cry > 0, "1", "0.45") & ";'><div class='alloc-top'><span class='alloc-name'>Crypto (Criptoativos)</span><span class='alloc-nums'><span class='alloc-val'>" & FORMAT(v_cry, """R$"" #,0.00", "pt-BR") & "</span><span class='alloc-pct'>(" & FORMAT(p_cry, "0.0%", "pt-BR") & ")</span></span></div><div class='prog-track'><div class='prog-fill' style='width:" & FORMAT(MIN(p_cry * 100, 100), "0.0", "en-US") & "%;background:#CA0AA7;'></div></div></div>" &
			"<div class='alloc-row' style='opacity:" & IF(v_out > 0, "1", "0.45") & ";'><div class='alloc-top'><span class='alloc-name'>LCA &amp; Moedas Estrangeiras</span><span class='alloc-nums'><span class='alloc-val'>" & FORMAT(v_out, """R$"" #,0.00", "pt-BR") & "</span><span class='alloc-pct'>(" & FORMAT(p_out, "0.0%", "pt-BR") & ")</span></span></div><div class='prog-track'><div class='prog-fill' style='width:" & FORMAT(MIN(p_out * 100, 100), "0.0", "en-US") & "%;background:#6D6865;'></div></div></div>" &
			"</div>" &
			"<div class='callout' style='background:#EFF6FF;border:1px solid #DBEAFE;color:#1E3A5F;font-size:9px;font-weight:700;'>Perfil: " & pct_rf & " Renda Fixa Segura &bull; " & pct_rv & " Renda Variável &amp; Alternativos</div>" &
			"</div>"
		displayFolder: html_visuais
		lineageTag: a1b2c3d4-0012-4000-8000-000000000012

	/// Visual HTML: Card Inferior 1 de Investimentos (Renda Fixa Pós / CDI + Moldura p/ Gráfico Nativo)
	measure html_inv_card_cdi =
			VAR v_saldo = FORMAT([rendimento_cdi], """R$"" #,0.00;-""R$"" #,0.00;""R$"" 0.00", "pt-BR")
			VAR n_lucro = [dif_rendido_cdi]
			VAR v_lucro = FORMAT(n_lucro, "+""R$"" #,0.00;-""R$"" #,0.00;""R$"" 0.00", "pt-BR")
			VAR v_pct = FORMAT([dif_rendido_cdi_porcent], "+0.00%;-0.00%;0.00%", "pt-BR")
			VAR cor_badge = IF(n_lucro >= 0, "#10715A", "#FF4A53")
			RETURN
			[html_css_base] &
			"<div class='card sec' style='height:320px;padding:13px 15px 14px 15px;'>" &
			"<div class='sec-head'>" &
			"<div><div class='head-l'><span class='sq-md' style='background:#10715A;'></span><span class='sec-ttl'>RENDA FIXA PÓS (CDI / PORQUINHO)</span></div><div class='sec-sub'>Capitalização diária real via API do Banco Central (DIM_CDI)</div></div>" &
			"<span class='pill' style='background:#DCFCE7;color:#10715A;'>100% DO CDI</span>" &
			"</div>" &
			"<div class='div-line' style='margin:7px 0 8px 0;'></div>" &
			"<div class='sub-box' style='height:82px;margin-bottom:9px;'>" &
			"<span class='sub-lbl'>SALDO ATUALIZADO NO CDI (R$)</span>" &
			"<span class='sub-val' style='color:#10715A;'>" & v_saldo & "</span>" &
			"<span class='sub-meta'><span>Lucro CDI: <b>" & v_lucro & "</b></span><span class='delta-pill' style='background:" & cor_badge & ";'>" & v_pct & "</span></span>" &
			"</div>" &
			"<div class='sub-box' style='height:144px;flex:1;min-height:144px;justify-content:flex-start;padding:8px 11px;'>" &
			"<span class='sub-lbl'>EVOLUÇÃO DA TAXA DIÁRIA CDI (% A.D.)</span>" &
			"</div></div>"
		displayFolder: html_visuais
		lineageTag: a1b2c3d4-0013-4000-8000-000000000013

	/// Visual HTML: Card Inferior 2 de Investimentos (Carteira Cripto & Cotação PTAX + Moldura p/ Gráfico Nativo)
	measure html_inv_card_crypto =
			VAR v_pos = FORMAT([rendimento_crypto], """R$"" #,0.00;-""R$"" #,0.00;""R$"" 0.00", "pt-BR")
			VAR v_usd = FORMAT([saldo_crypto_usd], """US$"" #,0.00;-""US$"" #,0.00;""US$"" 0.00", "pt-BR")
			VAR n_dif = [dif_rendido_crypto]
			VAR v_dif = FORMAT(n_dif, "+""R$"" #,0.00;-""R$"" #,0.00;""R$"" 0.00", "pt-BR")
			VAR v_pct = FORMAT([dif_rendido_crypto_porcent], "+0.00%;-0.00%;0.00%", "pt-BR")
			VAR cor_badge = IF(n_dif >= 0, "#3B89E2", "#FF4A53")
			RETURN
			[html_css_base] &
			"<div class='card sec' style='height:320px;padding:13px 15px 14px 15px;'>" &
			"<div class='sec-head'>" &
			"<div><div class='head-l'><span class='sq-md' style='background:#3B89E2;'></span><span class='sec-ttl'>CARTEIRA CRIPTO &amp; COTAÇÃO PTAX</span></div><div class='sec-sub'>Posição cambial em USD convertida pela PTAX (DIM_DOLAR)</div></div>" &
			"<span class='pill' style='background:#EFF6FF;color:#3B89E2;'>CÂMBIO PTAX</span>" &
			"</div>" &
			"<div class='div-line' style='margin:7px 0 8px 0;'></div>" &
			"<div class='sub-box' style='height:82px;margin-bottom:9px;'>" &
			"<span class='sub-lbl'>POSIÇÃO CAMBIAL CRIPTO (USD DINÂMICO &times; PTAX)</span>" &
			"<span class='sub-val' style='color:#10715A;'>" & v_pos & "</span>" &
			"<span class='sub-meta'><span>" & v_usd & " &bull; Var. Cambial: <b>" & v_dif & "</b></span><span class='delta-pill' style='background:" & cor_badge & ";'>" & v_pct & "</span></span>" &
			"</div>" &
			"<div class='sub-box' style='height:144px;flex:1;min-height:144px;justify-content:flex-start;padding:8px 11px;'>" &
			"<span class='sub-lbl'>HISTÓRICO COTAÇÃO DÓLAR PTAX (COMPRA)</span>" &
			"</div></div>"
		displayFolder: html_visuais
		lineageTag: a1b2c3d4-0014-4000-8000-000000000014

	/// Visual HTML: Card Inferior 3 de Investimentos (Estratégia & Metas de Acúmulo)
	measure html_inv_card_estrategia =
			VAR n_media = [media_mensal_aportes]
			VAR n_meta = [meta_aporte_mensal]
			VAR v_media = FORMAT(n_media, """R$"" #,0.00;-""R$"" #,0.00;""R$"" 0.00", "pt-BR")
			VAR v_meta = FORMAT(n_meta, """R$"" #,0.00;-""R$"" #,0.00;""R$"" 0.00", "pt-BR")
			VAR pct_meta = DIVIDE(n_media, n_meta, 0)
			VAR v_pct_meta = FORMAT(pct_meta, "0.0%", "pt-BR")
			VAR cor_meta = IF(n_media >= n_meta, "#10715A", "#D97706")
			VAR v_poup = FORMAT([taxa_poupanca], "0.0%", "pt-BR")
			VAR v_caixa = FORMAT([fluxo_caixa_liquido], """R$"" #,0.00;-""R$"" #,0.00;""R$"" 0.00", "pt-BR")
			RETURN
			[html_css_base] &
			"<div class='card sec' style='height:320px;padding:13px 15px 14px 15px;'>" &
			"<div class='sec-head'>" &
			"<div><div class='head-l'><span class='sq-md' style='background:#F99C3E;'></span><span class='sec-ttl'>ESTRATÉGIA &amp; METAS DE ACÚMULO</span></div><div class='sec-sub'>Ritmo mensal de aportes, poupança e diretriz de alocação</div></div>" &
			"<span class='pill' style='background:#FEF3C7;color:#D97706;'>PLANEJAMENTO</span>" &
			"</div>" &
			"<div class='div-line' style='margin:7px 0 8px 0;'></div>" &
			"<div class='sub-box' style='height:82px;margin-bottom:9px;'>" &
			"<span class='sub-lbl'>MÉDIA MENSAL DE APORTES VS META</span>" &
			"<span class='sub-val'>" & v_media & "</span>" &
			"<span class='sub-meta'><span>Meta Planejada: <b>" & v_meta & "</b></span><span class='delta-pill' style='background:" & cor_meta & ";'>" & v_pct_meta & "</span></span>" &
			"</div>" &
			"<div class='sub-box' style='height:82px;margin-bottom:9px;'>" &
			"<span class='sub-lbl'>TAXA DE POUPANÇA OPERACIONAL (% DA RENDA)</span>" &
			"<span class='sub-val' style='color:#3B89E2;'>" & v_poup & "</span>" &
			"<span class='sub-meta'>Caixa Livre Acum.: <b>" & v_caixa & "</b></span>" &
			"</div>" &
			"<div class='callout' style='flex:1;display:flex;flex-direction:column;justify-content:center;background:#FEF3C7;border:1px solid #FDE68A;'>" &
			"<div style='font-size:8.5px;font-weight:700;color:#B45309;letter-spacing:0.3px;'>DIRETRIZ DE ALOCAÇÃO DE NOVOS APORTES</div>" &
			"<div style='font-size:9.5px;font-weight:700;color:#92400E;margin-top:2px;'>50% CDI Liquidez &bull; 30% LCI &amp; Tesouro &bull; 20% FIIs &amp; Cripto</div>" &
			"</div>" &
			"</div>"
		displayFolder: html_visuais
		lineageTag: a1b2c3d4-0015-4000-8000-000000000015

	/// Visual HTML: Overlay transparente para o Cartão Inter Crédito na Carteira Digital
	measure html_vg_card_inter_credito =
			VAR n_aberta = [fatura_aberta_inter_credito]
			VAR v_aberta = FORMAT(n_aberta, """R$"" #,0.00;-""R$"" #,0.00;""R$"" 0.00", "pt-BR")
			VAR v_gasto_ic = FORMAT([gasto_inter_credito], """R$"" #,0.00;-""R$"" #,0.00;""R$"" 0.00", "pt-BR")
			VAR v_ult_fat = FORMAT([ultima_fatura_inter_credito], """R$"" #,0.00;-""R$"" #,0.00;""R$"" 0.00", "pt-BR")
			VAR tag_ic = IF(n_aberta <= 0, "<span class='b-tag' style='background:rgba(201,253,138,0.18);color:#C9FD8A;'>Quitada</span>", "<span class='b-tag' style='background:rgba(255,152,56,0.22);color:#FFB366;'>Em aberto</span>")
			RETURN
			[html_css_base] &
			"<div class='bcard-overlay'>" &
			"<div class='b-val-line'><span class='b-val' style='font-size:21px;'>" & v_aberta & "</span>" & tag_ic & "</div>" &
			"<div class='b-ref' style='padding-right:32px;font-size:9px;color:#FFB366;'>No Período: " & v_gasto_ic & " | Últ. Fat.: " & v_ult_fat & "</div>" &
			"</div>"
		displayFolder: html_visuais
		lineageTag: a1b2c3d4-0016-4000-8000-000000000016

	/// Visual HTML: Overlay transparente para o Cartão Flash Benefícios na Carteira Digital
	measure html_vg_card_flash =
			VAR v_flash = FORMAT([saldo_flash], """R$"" #,0.00;-""R$"" #,0.00;""R$"" 0.00", "pt-BR")
			VAR v_flash_ont = FORMAT([saldo_flash_ontem], """R$"" #,0.00;-""R$"" #,0.00;""R$"" 0.00", "pt-BR")
			RETURN
			[html_css_base] &
			"<div class='bcard-overlay'>" &
			"<div class='b-val-line'><span class='b-val' style='font-size:21px;'>" & v_flash & "</span></div>" &
			"<div class='b-ref' style='padding-right:32px;font-size:9px;color:#FFE4E6;'>Ontem: " & v_flash_ont & " &bull; Cartão Pré-Pago VR/VA</div>" &
			"</div>"
		displayFolder: html_visuais
		lineageTag: a1b2c3d4-0017-4000-8000-000000000017

	/// Visual HTML: Overlay transparente para o Cartão Wise Internacional na Carteira Digital
	measure html_vg_card_wise =
			VAR v_wise = FORMAT([saldo_wise], """R$"" #,0.00;-""R$"" #,0.00;""R$"" 0.00", "pt-BR")
			VAR v_cambio = FORMAT([cambio_acumulado_wise], """R$"" #,0.00;-""R$"" #,0.00;""R$"" 0.00", "pt-BR")
			RETURN
			[html_css_base] &
			"<div class='bcard-overlay'>" &
			"<div class='b-val-line'><span class='b-val' style='font-size:21px;color:#C9FD8A;'>" & v_wise & "</span></div>" &
			"<div class='b-ref' style='padding-right:32px;font-size:9px;color:#D9F99D;'>Câmbio Acum.: " & v_cambio & " &bull; Conta Multimoeda</div>" &
			"</div>"
		displayFolder: html_visuais
		lineageTag: a1b2c3d4-0018-4000-8000-000000000018

	/// Taxa média diária do CDI (% a.d.) para o gráfico de evolução na aba Investimentos
	measure taxa_cdi_media = AVERAGE(DIM_CDI[TAXA])
		formatString: 0.0000
		displayFolder: investimentos
		lineageTag: 4e8a9c10-7b2f-4d1e-9a3c-5f6e7d8c9b01

	/// Cotação média de compra do Dólar PTAX (DIM_DOLAR) para o gráfico de câmbio na aba Investimentos
	measure cotacao_dolar_ptax = AVERAGE(DIM_DOLAR[COTACAO_COMPRA])
		formatString: "R$"\ #,0.0000;-"R$"\ #,0.0000;"R$"\ #,0.0000
		displayFolder: investimentos
		lineageTag: 4e8a9c10-7b2f-4d1e-9a3c-5f6e7d8c9b02

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	partition Medidas = m
		mode: import
		source =
				let
				    Fonte = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"Coluna 1" = _t]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"Coluna 1", type text}}),
				    #"Colunas Removidas" = Table.RemoveColumns(#"Tipo Alterado",{"Coluna 1"})
				in
				    #"Colunas Removidas"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegação

