		lineageTag: 5a33e604-9b47-4c1d-a346-1f034b56c713

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Volume total aportado em investimentos (Renda Fixa, Tesouro, FIIs e Cripto)
	measure aportes_totais =
			VAR total_aportes =
			    CALCULATE(
			        [soma_valor],
			        FAT_FINANCES[TYPE] = "Despesa",
			        KEEPFILTERS(NOT ISBLANK(FAT_FINANCES[SUB_CATEGORY])),
			        KEEPFILTERS(FAT_FINANCES[CATEGORY] = "Investimentos - Aporte")
			    )
			RETURN
			    IF(
			        ISINSCOPE(DIM_CALENDARIO[ano_mes]) && ISBLANK(SELECTEDVALUE(DIM_CALENDARIO[ano_mes])),
			        BLANK(),
			        IF(
			            ISINSCOPE(FAT_FINANCES[SUB_CATEGORY]) || ISINSCOPE(FAT_FINANCES[CATEGORY]),
			            total_aportes,
			            COALESCE(total_aportes, 0)
			        )
			    )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: investimentos
		lineageTag: 6b44f715-0c58-4d2e-b457-2a145c67d814

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Volume total resgatado de investimentos e poupança
	measure resgates_totais =
			VAR total_resgates =
			    CALCULATE(
			        [soma_valor],
			        FAT_FINANCES[TYPE] = "Receita",
			        KEEPFILTERS(NOT ISBLANK(FAT_FINANCES[SUB_CATEGORY])),
			        KEEPFILTERS(FAT_FINANCES[CATEGORY] IN { "Renda Extra & Investimentos", "Investimentos - Rendimentos" }),
			        KEEPFILTERS(FAT_FINANCES[SUB_CATEGORY] <> "Vendas")
			    )
			VAR total_aportes_contexto =
			    CALCULATE(
			        [soma_valor],
			        FAT_FINANCES[TYPE] = "Despesa",
			        KEEPFILTERS(NOT ISBLANK(FAT_FINANCES[SUB_CATEGORY])),
			        KEEPFILTERS(FAT_FINANCES[CATEGORY] = "Investimentos - Aporte")
			    )
			RETURN
			    IF(
			        ISINSCOPE(DIM_CALENDARIO[ano_mes]) && ISBLANK(SELECTEDVALUE(DIM_CALENDARIO[ano_mes])),
			        BLANK(),
			        IF(
			            ISINSCOPE(DIM_CALENDARIO[ano_mes]),
			            total_resgates,
			            IF(
			                ISINSCOPE(FAT_FINANCES[SUB_CATEGORY]) || ISINSCOPE(FAT_FINANCES[CATEGORY]),
			                IF(
			                    NOT ISBLANK(total_aportes_contexto) || NOT ISBLANK(total_resgates),
			                    COALESCE(total_resgates, 0),
			                    BLANK()
			                ),
			                COALESCE(total_resgates, 0)
			            )
			        )
			    )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: investimentos
		lineageTag: 7c55a826-1d69-4e3f-a568-3b256d78e915

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Aporte líquido acumulado (Total Aportado menos Total Resgatado)
	measure aporte_liquido_investimentos =
			VAR aportado = [aportes_totais]
			VAR resgatado = [resgates_totais]
			RETURN
			    IF(
			        ISINSCOPE(DIM_CALENDARIO[ano_mes]) && ISBLANK(SELECTEDVALUE(DIM_CALENDARIO[ano_mes])),
			        BLANK(),
			        IF(
			            ISBLANK(aportado) && ISBLANK(resgatado),
			            BLANK(),
			            COALESCE(aportado, 0) - COALESCE(resgatado, 0)
			        )
			    )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: investimentos
		lineageTag: 8d66b937-2e70-4f4a-b679-4c367e89f016

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Quantidade de transações de aporte em investimentos
	measure qtd_aportes =
			VAR contagem =
			    CALCULATE(
			        COUNTROWS(FAT_FINANCES),
			        FAT_FINANCES[TYPE] = "Despesa",
			        KEEPFILTERS(NOT ISBLANK(FAT_FINANCES[SUB_CATEGORY])),
			        KEEPFILTERS(FAT_FINANCES[CATEGORY] = "Investimentos - Aporte")
			    )
			RETURN
			    IF(
			        ISINSCOPE(FAT_FINANCES[SUB_CATEGORY]) || ISINSCOPE(FAT_FINANCES[CATEGORY]),
			        IF(
			            NOT ISBLANK([aportes_totais]) || NOT ISBLANK([resgates_totais]),
			            COALESCE(contagem, 0),
			            BLANK()
			        ),
			        COALESCE(contagem, 0)
			    )
		formatString: #,0
		displayFolder: investimentos
		lineageTag: 9e77c048-3f81-4a5b-a780-5d478f90a117

	/// Participação percentual do ativo no volume total de aportes da carteira
	measure participacao_carteira_porcent =
			VAR aporte_ativo = [aportes_totais]
			VAR aporte_global =
			    CALCULATE(
			        [aportes_totais],
			        ALLSELECTED(FAT_FINANCES[SUB_CATEGORY])
			    )
			RETURN
			    IF(
			        ISINSCOPE(FAT_FINANCES[SUB_CATEGORY]) || ISINSCOPE(FAT_FINANCES[CATEGORY]),
			        IF(
			            NOT ISBLANK(aporte_ativo) || NOT ISBLANK([resgates_totais]),
			            DIVIDE(COALESCE(aporte_ativo, 0), aporte_global, 0),
			            BLANK()
			        ),
			        DIVIDE(aporte_ativo, aporte_global, 0)
			    )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: investimentos
		lineageTag: 0f88d159-4a92-4b6c-b891-6e589a01b218

	/// Total investido em LCI (Renda Fixa Isenta de IR)
	measure total_investido_lci =
			VAR total_lci =
			    CALCULATE(
			        [soma_valor],
			        FAT_FINANCES[SUB_CATEGORY] = "LCI",
			        FAT_FINANCES[TYPE] = "Despesa"
			    )
			RETURN
			    COALESCE(total_lci, 0)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: investimentos
		lineageTag: 1a99e260-5b03-4c7d-a902-7f690b12c319

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Total investido em Tesouro Direto
	measure total_investido_tesouro =
			VAR total_tesouro =
			    CALCULATE(
			        [soma_valor],
			        FAT_FINANCES[SUB_CATEGORY] = "Tesouro Direto",
			        FAT_FINANCES[TYPE] = "Despesa"
			    )
			RETURN
			    COALESCE(total_tesouro, 0)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: investimentos
		lineageTag: 2b00f371-6c14-4d8e-b013-8a701c23d420

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Total investido em FIIs e ETFs
	measure total_investido_fiis =
			VAR total_fiis =
			    CALCULATE(
			        [soma_valor],
			        FAT_FINANCES[TYPE] = "Despesa",
			        KEEPFILTERS(FAT_FINANCES[SUB_CATEGORY] IN { "FII's & ETF’s", "FII's / ETF’s", "FII's & ETF's", "FII's / ETF's" })
			    )
			RETURN
			    COALESCE(total_fiis, 0)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: investimentos
		lineageTag: 3c11a482-7d25-4e9f-a124-9b812d34e521

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Patrimônio ativo estimado na carteira somando posições em CDI corrigido, LCI, LCA, Tesouro, FIIs e Cripto
	measure patrimonio_investido_estimado =
			VAR saldo_cdi = [rendimento_cdi]
			VAR saldo_lci = [total_investido_lci]
			VAR saldo_lca =
			    COALESCE(
			        CALCULATE(
			            [soma_valor],
			            FAT_FINANCES[SUB_CATEGORY] = "LCA",
			            FAT_FINANCES[TYPE] = "Despesa"
			        ),
			        0
			    )
			VAR saldo_tesouro = [total_investido_tesouro]
			VAR saldo_fiis = [total_investido_fiis]
			VAR saldo_crypto = [rendimento_crypto]
			RETURN
			    saldo_cdi + saldo_lci + saldo_lca + saldo_tesouro + saldo_fiis + saldo_crypto
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: investimentos
		lineageTag: 4d22b593-8e36-4f0a-b235-0c923e45f622

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Lucro nominal estimado acumulado nos indexadores monitorados (DIM_CDI + Variação Cambial Cripto)
	measure lucro_total_estimado =
			VAR lucro_cdi = [dif_rendido_cdi]
			VAR variacao_crypto = [dif_rendido_crypto]
			RETURN
			    lucro_cdi + variacao_crypto
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: investimentos
		lineageTag: 5e33c604-9f47-4a1b-a346-1d034f56a723

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Rentabilidade percentual estimada sobre o capital líquido investido no CDI
	measure rentabilidade_carteira_porcent =
			VAR rentabilidade = [dif_rendido_cdi_porcent]
			RETURN
			    rentabilidade
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: investimentos
		lineageTag: 6f44d715-0a58-4b2c-b457-2e145a67b824

	/// Média mensal de aportes realizados em investimentos
	measure media_mensal_aportes =
			VAR media_aportes =
			    AVERAGEX(
			        FILTER(
			            VALUES(DIM_CALENDARIO[ano_mes]),
			            NOT ISBLANK(DIM_CALENDARIO[ano_mes])
			        ),
			        [aportes_totais]
			    )
			RETURN
			    COALESCE(media_aportes, 0)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: investimentos
		lineageTag: 7a55e826-1b69-4c3d-a568-3f256b78c925

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Meta planejada de aporte mensal recorrente
	measure meta_aporte_mensal =
			VAR meta = 2000
			RETURN
			    meta
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: investimentos
		lineageTag: 8b66f937-2c70-4d4e-b679-4a367c89d026

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Orçamento mensal fixo destinado à subcategoria Mercado Mãe (R$ 500,00)
	measure orcamento_mercado_mae =
			VAR teto = 500
			RETURN
			    teto
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: orcamentos
		lineageTag: 9c77a048-3d81-4e5f-a780-5b478d90e127

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Gasto realizado em Mercado Mãe no mês mais recente do contexto selecionado
	measure gasto_mercado_mae_mes =
			VAR ultima_data =
			    CALCULATE(
			        MAX(FAT_FINANCES[DATE]),
			        FAT_FINANCES[SUB_CATEGORY] = "Mercado Mãe"
			    )
			VAR ano_ref = YEAR(COALESCE(ultima_data, TODAY()))
			VAR mes_ref = MONTH(COALESCE(ultima_data, TODAY()))
			VAR gasto_mes =
			    CALCULATE(
			        [soma_mercado_mae],
			        YEAR(FAT_FINANCES[DATE]) = ano_ref &&
			        MONTH(FAT_FINANCES[DATE]) = mes_ref
			    )
			RETURN
			    COALESCE(gasto_mes, 0)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: orcamentos
		lineageTag: 0d88b159-4e92-4f6a-b891-6c589e01f228

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Percentual consumido do teto mensal de R$ 500 para Mercado Mãe
	measure porcent_mercado_mae_mes =
			VAR gasto = [gasto_mercado_mae_mes]
			VAR teto = [orcamento_mercado_mae]
			RETURN
			    DIVIDE(gasto, teto, 0)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: orcamentos
		lineageTag: 1e99c260-5f03-4a7b-a902-7d690f12a329

	/// Média mensal histórica de gastos na subcategoria Mercado Mãe
	measure media_mensal_mercado_mae =
			VAR media_mensal =
			    AVERAGEX(
			        FILTER(
			            VALUES(DIM_CALENDARIO[ano_mes]),
			            NOT ISBLANK(DIM_CALENDARIO[ano_mes])
			        ),
			        [soma_mercado_mae]
			    )
			RETURN
			    COALESCE(media_mensal, 0)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: orcamentos
		lineageTag: 2f00d371-6a14-4b8c-b013-8e701a23b430

