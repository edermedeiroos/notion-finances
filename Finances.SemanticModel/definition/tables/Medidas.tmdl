	/// Visual HTML: KPI 3 da Visão Geral (Custo de Vida Real)
	measure html_vg_kpi_custo_vida =
			VAR v_custo = FORMAT([custo_vida_real], """R$"" #,0.00;-""R$"" #,0.00;""R$"" 0.00", "pt-BR")
			VAR v_comp = FORMAT([taxa_comprometimento_renda], "0.0%", "pt-BR")
