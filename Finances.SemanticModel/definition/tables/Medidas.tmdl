		lineageTag: 7e55c826-1f69-4a3b-a568-3d256f78a905

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Entradas operacionais de renda própria líquida (exclui reembolsos de empréstimos, liquidações de fatura e resgates de aplicações; inclui vendas pessoais)
	measure receitas_operacionais =
			VAR receitas =
			    CALCULATE(
			        [soma_valor],
			        FAT_FINANCES[TYPE] = "Receita",
			        KEEPFILTERS(NOT ISBLANK(FAT_FINANCES[CATEGORY])),
			        KEEPFILTERS(
			            FILTER(
			                ALL(FAT_FINANCES[CATEGORY], FAT_FINANCES[SUB_CATEGORY]),
			                NOT FAT_FINANCES[CATEGORY] IN { "Faturas", "Investimentos - Rendimentos" } &&
			                NOT (FAT_FINANCES[CATEGORY] = "Renda Extra & Investimentos" && FAT_FINANCES[SUB_CATEGORY] <> "Vendas") &&
			                NOT FAT_FINANCES[SUB_CATEGORY] IN { "Moedas Estrangeiras", "Saldo Inicial", "Retorno - Empréstimos" }
			            )
			        )
			    )
			RETURN
			    IF(
			        ISINSCOPE(DIM_CALENDARIO[ano_mes]) && ISBLANK(SELECTEDVALUE(DIM_CALENDARIO[ano_mes])),
			        BLANK(),
			        IF(
			            ISINSCOPE(FAT_FINANCES[CATEGORY]) || ISINSCOPE(FAT_FINANCES[SUB_CATEGORY]),
			            receitas,
			            COALESCE(receitas, 0)
			        )
			    )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: fluxo_caixa
		lineageTag: 8f66d937-2a70-4b4c-b679-4e367a89b006

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Despesas reais de custo de vida próprio (exclui aportes, faturas, saída de empréstimos e transferências internas para Wise, considerando na Wise apenas gastos efetivos)
	measure custo_vida_real =
			VAR despesas_consumo =
			    CALCULATE(
			        [soma_valor],
			        FAT_FINANCES[TYPE] = "Despesa",
			        KEEPFILTERS(NOT ISBLANK(FAT_FINANCES[CATEGORY])),
			        KEEPFILTERS(NOT FAT_FINANCES[CATEGORY] IN { "Investimentos - Aporte", "Faturas", "Investimentos - Rendimentos", "Renda Extra & Investimentos" }),
			        KEEPFILTERS(
			            FILTER(
			                ALL(FAT_FINANCES[SUB_CATEGORY], FAT_FINANCES[ACCOUNT]),
			                FAT_FINANCES[SUB_CATEGORY] <> "Saída - Empréstimos" &&
			                NOT (FAT_FINANCES[SUB_CATEGORY] = "Moedas Estrangeiras" && FAT_FINANCES[ACCOUNT] <> "Wise")
			            )
			        )
			    )
			RETURN
			    IF(
			        ISINSCOPE(DIM_CALENDARIO[ano_mes]) && ISBLANK(SELECTEDVALUE(DIM_CALENDARIO[ano_mes])),
			        BLANK(),
			        IF(
			            ISINSCOPE(FAT_FINANCES[CATEGORY]) || ISINSCOPE(FAT_FINANCES[SUB_CATEGORY]),
			            despesas_consumo,
			            COALESCE(despesas_consumo, 0)
			        )
			    )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: fluxo_caixa
		lineageTag: 9a77e048-3b81-4c5d-a780-5f478b90c107

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Geração de caixa operacional livre no período (Receitas Operacionais menos Custo de Vida Real)
	measure fluxo_caixa_liquido =
			VAR entradas = [receitas_operacionais]
			VAR saidas = [custo_vida_real]
			RETURN
			    IF(
			        ISINSCOPE(DIM_CALENDARIO[ano_mes]) && ISBLANK(SELECTEDVALUE(DIM_CALENDARIO[ano_mes])),
			        BLANK(),
			        IF(
			            ISBLANK(entradas) && ISBLANK(saidas),
			            BLANK(),
			            COALESCE(entradas, 0) - COALESCE(saidas, 0)
			        )
			    )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: fluxo_caixa
		lineageTag: 0b88f159-4c92-4d6e-b891-6a589c01d208

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Percentual de comprometimento da receita operacional com o custo de vida
	measure taxa_comprometimento_renda =
			VAR custo = [custo_vida_real]
			VAR receita = [receitas_operacionais]
			RETURN
			    DIVIDE(custo, receita, 0)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: fluxo_caixa
		lineageTag: 1c99a260-5d03-4e7f-a902-7b690d12e309

	/// Taxa de poupança operacional sobre a receita (geração de caixa livre percentual)
	measure taxa_poupanca =
			VAR geracao_caixa = [fluxo_caixa_liquido]
			VAR receita = [receitas_operacionais]
			RETURN
			    DIVIDE(geracao_caixa, receita, 0)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: fluxo_caixa
		lineageTag: 2d00b371-6e14-4f8a-b013-8c701e23f410

	/// Participação percentual da categoria ou subcategoria sobre o custo de vida total selecionado
	measure participacao_custo_vida =
			VAR custo_atual = [custo_vida_real]
			VAR custo_total =
			    CALCULATE(
			        [custo_vida_real],
			        ALLSELECTED(FAT_FINANCES[CATEGORY], FAT_FINANCES[SUB_CATEGORY])
			    )
			RETURN
			    IF(
			        NOT ISBLANK(custo_atual),
			        DIVIDE(custo_atual, custo_total, 0)
			    )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: fluxo_caixa
		lineageTag: 3e11c482-7f25-4a9b-a124-9d812f34a511

	/// Volume bruto aportado em aplicações atreladas ao CDI
	measure aportes_brutos_cdi =
			VAR bruto_cdi =
			    CALCULATE(
			        [soma_valor],
			        FAT_FINANCES[SUB_CATEGORY] = "CDI",
			        FAT_FINANCES[TYPE] = "Despesa"
			    )
			RETURN
