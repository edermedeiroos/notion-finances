	measure total_rendido_crypto = 100
		formatString: 0
		displayFolder: crypo
		lineageTag: b5d6c58a-bae8-4f12-bd78-ea1f9c37c309

	measure total_rendido_cdi = 100
		formatString: 0
		displayFolder: cdi
		lineageTag: ba8a5551-bd03-405e-9a08-bba76a9369ed

	measure rendimento_cdi = ```
			
			VAR DataAtual = MAX(DIM_CALENDARIO[Date])
			
			RETURN
			SUMX(
			    // 1. Filtramos apenas as transações referentes ao Porquinho
			    FILTER(
			        FAT_FINANCES,
			        FAT_FINANCES[DATE] <= DataAtual &&
			        FAT_FINANCES[SUB_CATEGORY] = "CDI" 
			    ),
			    
			    // 2. Invertemos o sinal (Aporte vem negativo no EFECTIVE_VALUE, multiplicamos para ficar positivo)
			    VAR DataTransacao = FAT_FINANCES[DATE]
			    VAR ValorTransacao = FAT_FINANCES[EFECTIVE_VALUE] * -1
			    
			    // 3. Calculamos o juros compostos corrigindo a escala da taxa (dividindo por 100)
			    VAR FatorRendimento = 
			        PRODUCTX(
			            FILTER(
			                DIM_CDI,
			                DIM_CDI[DATA] > DataTransacao && 
			                DIM_CDI[DATA] <= DataAtual
			            ),
			            1 + (DIM_CDI[TAXA] / 100)
			        )
			        
			    // 4. Retorna o valor atualizado
			    RETURN
			    ValorTransacao * COALESCE(FatorRendimento, 1)
			)
			```
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: cdi
		lineageTag: f96acef7-a031-4c28-a7a3-c6bc5ee3faf1

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure dif_rendido_cdi = [rendimento_cdi] - [total_investido_cdi]
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
