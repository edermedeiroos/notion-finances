	/// Total desembolsado em compras/aportes de criptoativos
	measure total_investido_crypto =
			VAR total_compras =
			    CALCULATE(
			        [soma_valor],
			        FAT_FINANCES[SUB_CATEGORY] = "Crypto",
			        FAT_FINANCES[TYPE] = "Despesa"
			    )
			RETURN
			    total_compras
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: crypto
		lineageTag: 988f53db-a9bb-4417-91d6-a22d6e1f8e68

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Total de aportes realizados em aplicações atreladas ao CDI
	measure total_investido_cdi =
			VAR total_aporte =
			    CALCULATE(
			        -1 * [soma_valor_efetivo],
			        FAT_FINANCES[SUB_CATEGORY] = "CDI"
			    )
			RETURN
			    total_aporte
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: cdi
		lineageTag: 983fce1d-4784-4d8b-af3f-4aed5781d91a

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Valor patrimonial atualizado dos aportes em CDI corrigidos diariamente pela taxa CDI
	measure rendimento_cdi = ```
			VAR data_atual = MAX(DIM_CALENDARIO[data])
			VAR transacoes_cdi = 
			    FILTER(
			        FAT_FINANCES,
			        FAT_FINANCES[DATE] <= data_atual &&
			        FAT_FINANCES[SUB_CATEGORY] = "CDI"
			    )
			RETURN
			SUMX(
			    transacoes_cdi,
			    VAR data_transacao = FAT_FINANCES[DATE]
			    VAR valor_transacao = FAT_FINANCES[EFECTIVE_VALUE] * -1
			    VAR fator_rendimento = 
			        PRODUCTX(
			            FILTER(
			                DIM_CDI,
			                DIM_CDI[DATA] > data_transacao && 
			                DIM_CDI[DATA] <= data_atual
			            ),
			            1 + (DIM_CDI[TAXA] / 100)
			        )
			    RETURN
			        valor_transacao * COALESCE(fator_rendimento, 1)
			)
			```
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: cdi
		lineageTag: f96acef7-a031-4c28-a7a3-c6bc5ee3faf1

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Lucro/prejuízo nominal obtido nos investimentos em CDI
	measure dif_rendido_cdi =
			VAR valor_atualizado = [rendimento_cdi]
			VAR valor_investido = [total_investido_cdi]
			RETURN
			    valor_atualizado - valor_investido
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: cdi
		lineageTag: cc155579-fcb1-4d2b-aa6a-ee65e7237bc4

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Rentabilidade percentual dos aportes em CDI em relação ao capital investido
	measure dif_rendido_cdi_porcent =
			VAR diferenca_nominal = [dif_rendido_cdi]
			VAR capital_investido = [total_investido_cdi]
			RETURN
			    DIVIDE(diferenca_nominal, capital_investido, 0)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: cdi
		lineageTag: 11307902-4e78-4f39-a448-172ea3d2007d

	/// Valor de mercado atual da carteira de criptoativos em BRL (saldo em USD x cotação)
	measure rendimento_crypto = ```
			VAR ultimo_preco_dolar = 
			    CALCULATE(
			        MAX(DIM_DOLAR[COTACAO_COMPRA]),
			        DIM_DOLAR[DATA_HORA] = MAX(DIM_DOLAR[DATA_HORA])
			    )
			VAR saldo_crypto_dolar = 360
			RETURN
			    saldo_crypto_dolar * ultimo_preco_dolar
			```
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: crypto
		lineageTag: 36d77984-f9c0-4981-88d8-f015771c27ed

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Lucro/prejuízo nominal da carteira de criptoativos em relação ao total investido
	measure dif_rendido_crypto =
			VAR valor_atual = [rendimento_crypto]
			VAR valor_investido = [total_investido_crypto]
			RETURN
			    valor_atual - valor_investido
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: crypto
		lineageTag: 15675467-fafc-4dd3-9e37-941b66585b05

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Rentabilidade percentual da carteira de criptoativos sobre o total investido
	measure dif_rendido_crypto_porcent =
			VAR diferenca_nominal = [dif_rendido_crypto]
			VAR capital_investido = [total_investido_crypto]
			RETURN
			    DIVIDE(diferenca_nominal, capital_investido, 0)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: crypto
		lineageTag: febc6ccd-dfa3-4640-96f3-821a0d6493be

	/// Total de gastos na subcategoria Mercado Mãe
	measure soma_mercado_mae =
			VAR total_gasto =
			    CALCULATE(
			        [soma_valor],
			        FAT_FINANCES[SUB_CATEGORY] = "Mercado Mãe"
			    )
			RETURN
			    total_gasto
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: orcamentos
		lineageTag: bac25db3-67dc-4c48-b1d8-e8276faffaa7

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Saldo restante do orçamento mensal (R$ 500) para Mercado Mãe no mês/ano correntes
	measure saldo_mercado_mae =
			VAR ano_atual = YEAR(TODAY())
			VAR mes_atual = MONTH(TODAY())
			VAR gasto_mes_atual =
			    CALCULATE(
			        [soma_mercado_mae],
			        YEAR(FAT_FINANCES[DATE]) = ano_atual &&
			        MONTH(FAT_FINANCES[DATE]) = mes_atual
			    )
			VAR orcamento_mensal = 500
			RETURN
			    gasto_mes_atual - orcamento_mensal
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: orcamentos
		lineageTag: 8cd79c9f-0200-47fa-833c-6689a080fa55

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

