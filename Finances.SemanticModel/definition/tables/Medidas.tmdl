	/// Total de saídas destinadas a empréstimos para familiares/terceiros (isolado do custo de vida próprio)
	measure saida_emprestimos =
			VAR total_saidas =
			    CALCULATE(
			        [soma_valor],
			        FAT_FINANCES[TYPE] = "Despesa",
			        FAT_FINANCES[SUB_CATEGORY] = "Saída - Empréstimos"
