	measure dif_rendido_cdi_porcent = DIVIDE([rendimento_cdi] - [total_investido_cdi], [total_investido_cdi])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: cdi
		lineageTag: 11307902-4e78-4f39-a448-172ea3d2007d

	measure rendimento_crypto = ```
			
			
			VAR ultimo_preco_dolar = 
			    CALCULATE(
			        MAX(DIM_DOLAR[COTACAO_COMPRA]),
			        DIM_DOLAR[DATA_HORA] = MAX(DIM_DOLAR[DATA_HORA])
			    )
			VAR saldo_crypto_dolar = 360
			
			RETURN saldo_crypto_dolar * ultimo_preco_dolar
			```
		displayFolder: crypo
		lineageTag: 36d77984-f9c0-4981-88d8-f015771c27ed

		annotation PBI_FormatHint = {"isGeneralNumber":true}

