	/// Saldo acumulado na conta Wise até o dia anterior (ontem)
	measure saldo_wise_ontem =
			VAR saldo_anterior =
			    CALCULATE(
			        [saldo_wise],
			        DIM_CALENDARIO[data] < TODAY()
			    )
			RETURN
			    saldo_anterior
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
