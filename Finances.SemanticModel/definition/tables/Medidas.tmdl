			".b-badge{font-size:7px;font-weight:700;padding:2px 7px;border-radius:9px;letter-spacing:0.2px;}" &
			".b-chip{display:flex;align-items:center;gap:6px;position:relative;z-index:1;}" &
			".b-digits{font-size:8.5px;font-weight:600;opacity:0.78;letter-spacing:0.5px;}" &
			".b-mid{position:relative;z-index:1;}" &
			".b-lbl{font-size:7.5px;font-weight:700;letter-spacing:0.45px;opacity:0.84;margin-bottom:1px;}" &
			".b-val-line{display:flex;align-items:baseline;gap:6px;}" &
			".b-val{font-size:17.5px;font-weight:700;line-height:1.15;color:#FFFFFF;}" &
			".b-tag{font-size:8px;font-weight:700;padding:1.5px 6px;border-radius:6px;}" &
			".b-foot{display:flex;justify-content:space-between;align-items:center;position:relative;z-index:1;}" &
			".b-ref{font-size:8.2px;font-weight:600;opacity:0.88;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}" &
			".circles{display:flex;align-items:center;flex:none;}" &
			".c1,.c2{width:13px;height:13px;border-radius:50%;}" &
			".c2{margin-left:-5px;}" &
			".mm-grid{flex:1;display:grid;grid-template-columns:238px 238px 250px 1fr;gap:11px;min-height:0;margin-top:8px;}" &
			".mm-track{height:22px;width:100%;background:#E5E7EB;border-radius:6px;position:relative;overflow:hidden;margin:3px 0;}" &
			".mm-fill{height:100%;border-radius:6px;display:flex;align-items:center;padding:0 8px;font-size:9px;font-weight:700;color:#FFFFFF;white-space:nowrap;}" &
			".mm-limit{position:absolute;top:0;bottom:0;width:2.5px;background:#D97706;z-index:2;}" &
			".mm-scale{display:flex;justify-content:space-between;font-size:8.5px;font-weight:600;color:#808080;}" &
			".alloc-list{flex:1;display:flex;flex-direction:column;justify-content:space-between;gap:6px;min-height:0;margin-bottom:8px;}" &
			".alloc-row{background:#F8F9FA;border:1px solid #EDEDED;border-radius:8px;padding:7px 10px;}" &
			".alloc-top{display:flex;justify-content:space-between;align-items:baseline;font-size:10px;margin-bottom:4px;gap:6px;}" &
			".alloc-name{font-weight:700;color:#252321;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}" &
			".alloc-nums{white-space:nowrap;flex:none;}" &
			".alloc-val{font-weight:700;color:#252321;}" &
			".alloc-pct{font-size:9px;font-weight:600;color:#6D6865;margin-left:3px;}" &
			".prog-track{height:6px;width:100%;background:#DCE1E7;border-radius:3px;overflow:hidden;}" &
			".prog-fill{height:100%;border-radius:3px;}" &
			".callout{border-radius:9px;padding:8px 11px;flex:none;}" &
			"</style>"
		displayFolder: html_visuais
		lineageTag: a1b2c3d4-0001-4000-8000-000000000001

	/// Visual HTML: KPI 1 da Visão Geral (Saldo Líquido em Contas)
	measure html_vg_kpi_saldo =
			VAR v_total = FORMAT([saldo_total_contas], """R$"" #,0.00;-""R$"" #,0.00;""R$"" 0.00", "pt-BR")
			VAR v_inter = FORMAT([saldo_inter], """R$"" #,0.00;-""R$"" #,0.00;""R$"" 0.00", "pt-BR")
			VAR v_flash = FORMAT([saldo_flash], """R$"" #,0.00;-""R$"" #,0.00;""R$"" 0.00", "pt-BR")
			RETURN
			[html_css_base] &
			"<div class='card kpi'>" &
			"<div class='kpi-bar' style='background:#3B89E2;'></div>" &
			"<div class='kpi-head'>" &
			"<div class='head-l'><span class='sq-sm' style='background:#3B89E2;'></span><span class='kpi-ttl'>SALDO LÍQUIDO EM CONTAS</span></div>" &
			"<span class='pill' style='background:#EFF6FF;color:#3B89E2;'>CAIXA ATUAL</span>" &
			"</div>" &
			"<div class='kpi-val-row'><span class='kpi-val'>" & v_total & "</span></div>" &
			"<div class='kpi-sub'>Inter Débito: " & v_inter & " &bull; Flash: " & v_flash & "</div>" &
			"</div>"
		displayFolder: html_visuais
		lineageTag: a1b2c3d4-0002-4000-8000-000000000002

