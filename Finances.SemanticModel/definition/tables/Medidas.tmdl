		displayFolder: investimentos
		lineageTag: 3c11a482-7d25-4e9f-a124-9b812d34e521

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Patrimônio ativo estimado na carteira somando posições em CDI corrigido, LCI, Tesouro, FIIs e Cripto
	measure patrimonio_investido_estimado =
			VAR saldo_cdi = [rendimento_cdi]
			VAR saldo_lci = [total_investido_lci]
			VAR saldo_tesouro = [total_investido_tesouro]
			VAR saldo_fiis = [total_investido_fiis]
			VAR saldo_crypto = [rendimento_crypto]
			RETURN
			    saldo_cdi + saldo_lci + saldo_tesouro + saldo_fiis + saldo_crypto
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: investimentos
		lineageTag: 4d22b593-8e36-4f0a-b235-0c923e45f622

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Lucro nominal estimado acumulado nos indexadores monitorados (DIM_CDI + USD)
	measure lucro_total_estimado =
			VAR lucro_cdi = [dif_rendido_cdi]
			RETURN
			    lucro_cdi
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: investimentos
		lineageTag: 5e33c604-9f47-4a1b-a346-1d034f56a723

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Rentabilidade percentual estimada sobre o capital líquido investido no CDI
	measure rentabilidade_carteira_porcent =
			VAR rentabilidade = [dif_rendido_cdi_porcent]
			RETURN
			    rentabilidade
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: investimentos
		lineageTag: 6f44d715-0a58-4b2c-b457-2e145a67b824

	/// Média mensal de aportes realizados em investimentos
	measure media_mensal_aportes =
			VAR media_aportes =
			    AVERAGEX(
			        VALUES(DIM_CALENDARIO[ano_mes]),
			        [aportes_totais]
			    )
			RETURN
			    COALESCE(media_aportes, 0)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: investimentos
		lineageTag: 7a55e826-1b69-4c3d-a568-3f256b78c925

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Meta planejada de aporte mensal recorrente
	measure meta_aporte_mensal =
			VAR meta = 2000
			RETURN
			    meta
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: investimentos
		lineageTag: 8b66f937-2c70-4d4e-b679-4a367c89d026

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Total de gastos na subcategoria Mercado Mãe
	measure soma_mercado_mae =
			VAR total_gasto =
			    CALCULATE(
			        [soma_valor],
			        FAT_FINANCES[SUB_CATEGORY] = "Mercado Mãe"
			    )
			RETURN
			    COALESCE(total_gasto, 0)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: orcamentos
		lineageTag: bac25db3-67dc-4c48-b1d8-e8276faffaa7

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Orçamento mensal fixo destinado à subcategoria Mercado Mãe (R$ 500,00)
	measure orcamento_mercado_mae =
			VAR teto = 500
			RETURN
			    teto
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: orcamentos
		lineageTag: 9c77a048-3d81-4e5f-a780-5b478d90e127

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Gasto realizado em Mercado Mãe no mês mais recente do contexto selecionado
	measure gasto_mercado_mae_mes =
			VAR ultima_data =
			    CALCULATE(
			        MAX(FAT_FINANCES[DATE]),
			        FAT_FINANCES[SUB_CATEGORY] = "Mercado Mãe"
			    )
			VAR ano_ref = YEAR(COALESCE(ultima_data, TODAY()))
			VAR mes_ref = MONTH(COALESCE(ultima_data, TODAY()))
			VAR gasto_mes =
			    CALCULATE(
			        [soma_mercado_mae],
			        YEAR(FAT_FINANCES[DATE]) = ano_ref &&
			        MONTH(FAT_FINANCES[DATE]) = mes_ref
			    )
			RETURN
			    COALESCE(gasto_mes, 0)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: orcamentos
		lineageTag: 0d88b159-4e92-4f6a-b891-6c589e01f228

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Saldo restante do orçamento mensal (R$ 500) para Mercado Mãe no mês de referência
	measure saldo_mercado_mae =
			VAR orcamento_mensal = [orcamento_mercado_mae]
			VAR gasto_mes_atual = [gasto_mercado_mae_mes]
			RETURN
			    orcamento_mensal - gasto_mes_atual
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: orcamentos
		lineageTag: 8cd79c9f-0200-47fa-833c-6689a080fa55

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Percentual consumido do teto mensal de R$ 500 para Mercado Mãe
	measure porcent_mercado_mae_mes =
			VAR gasto = [gasto_mercado_mae_mes]
			VAR teto = [orcamento_mercado_mae]
			RETURN
			    DIVIDE(gasto, teto, 0)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: orcamentos
		lineageTag: 1e99c260-5f03-4a7b-a902-7d690f12a329

	/// Média mensal histórica de gastos na subcategoria Mercado Mãe
	measure media_mensal_mercado_mae =
			VAR media_mensal =
			    AVERAGEX(
			        VALUES(DIM_CALENDARIO[ano_mes]),
			        [soma_mercado_mae]
			    )
			RETURN
			    COALESCE(media_mensal, 0)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: orcamentos
		lineageTag: 2f00d371-6a14-4b8c-b013-8e701a23b430

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Ticket médio por compra realizada em Mercado Mãe
	measure ticket_medio_mercado_mae =
			VAR media_compra =
			    CALCULATE(
			        AVERAGE(FAT_FINANCES[VALUE]),
			        FAT_FINANCES[SUB_CATEGORY] = "Mercado Mãe"
			    )
			RETURN
			    COALESCE(media_compra, 0)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: orcamentos
		lineageTag: 3a11e482-7b25-4c9d-a124-9f812b34c531

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	partition Medidas = m
		mode: import
		source =
				let
				    Fonte = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"Coluna 1" = _t]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"Coluna 1", type text}}),
				    #"Colunas Removidas" = Table.RemoveColumns(#"Tipo Alterado",{"Coluna 1"})
				in
				    #"Colunas Removidas"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegação
