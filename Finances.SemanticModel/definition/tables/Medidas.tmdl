table Medidas
	lineageTag: 2b0bd38f-f4ed-4a60-b962-3fe6ae9f3247

	/// Soma bruta de todos os valores de transações financeiras
	measure soma_valor =
			VAR total = SUM(FAT_FINANCES[VALUE])
			RETURN
			    total
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: a49ed57c-9ce5-40e3-9f73-1088859e2886

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Soma líquida dos valores efetivos das transações
	measure soma_valor_efetivo =
			VAR total_efetivo = SUM(FAT_FINANCES[EFECTIVE_VALUE])
			RETURN
			    total_efetivo
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: c7d523d8-055b-4afd-930b-cb4a1853b0bb

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Saldo acumulado na conta Inter - Débito
	measure saldo_inter =
			VAR saldo =
			    CALCULATE(
			        [soma_valor_efetivo],
			        FAT_FINANCES[ACCOUNT] = "Inter - Débito"
			    )
			RETURN
			    saldo
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: saldos
		lineageTag: 2db3e0de-c869-490f-8a6b-88a329363a02

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Saldo acumulado na conta Flash
	measure saldo_flash =
			VAR saldo =
			    CALCULATE(
			        [soma_valor_efetivo],
			        FAT_FINANCES[ACCOUNT] = "Flash"
			    )
			RETURN
			    saldo
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: saldos
		lineageTag: 7dbc390d-1abe-432e-bf2d-1690dd29bdb2

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Saldo acumulado na conta Flash até o dia anterior (ontem)
	measure saldo_flash_ontem =
			VAR saldo_anterior =
			    CALCULATE(
			        [saldo_flash],
			        DIM_CALENDARIO[data] < TODAY()
			    )
			RETURN
			    saldo_anterior
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: saldos
		lineageTag: f8af9522-87e6-4880-bb24-1cd820890aff

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Saldo acumulado na conta Inter - Débito até o dia anterior (ontem)
	measure saldo_inter_ontem =
			VAR saldo_anterior =
			    CALCULATE(
			        [saldo_inter],
			        DIM_CALENDARIO[data] < TODAY()
			    )
			RETURN
			    saldo_anterior
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
