	measure cambio_acumulado_wise =
			VAR total_wise =
			    CALCULATE(
			        [soma_valor],
			        REMOVEFILTERS(DIM_CALENDARIO),
			        FAT_FINANCES[ACCOUNT] = "Wise",
			        FAT_FINANCES[TYPE] = "Receita"
