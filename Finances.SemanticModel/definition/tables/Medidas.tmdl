			"</div>" &
			"<div class='kpi-val-row'><span class='kpi-val' style='color:#FF4A53;'>" & v_custo & "</span></div>" &
			"<div class='kpi-sub'>Comprometimento: " & v_comp & " da renda" & txt_emp & "</div>" &
			"</div>"
