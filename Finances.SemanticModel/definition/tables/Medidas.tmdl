	/// Ticket médio por compra realizada em Mercado Mãe
	measure ticket_medio_mercado_mae =
			VAR media_compra =
			    CALCULATE(
			        AVERAGE(FAT_FINANCES[VALUE]),
			        FAT_FINANCES[SUB_CATEGORY] = "Mercado Mãe"
			    )
			RETURN
			    COALESCE(media_compra, 0)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: orcamentos
		lineageTag: 3a11e482-7b25-4c9d-a124-9f812b34c531

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Quantidade estimada de dólares (USD) acumulados nos aportes de criptoativos conforme cotação PTAX da data de cada aporte
	measure saldo_crypto_usd =
			VAR data_limite = MAX(DIM_CALENDARIO[data])
			VAR transacoes_crypto =
			    FILTER(
			        ALL(FAT_FINANCES),
			        FAT_FINANCES[DATE] <= data_limite &&
			        FAT_FINANCES[SUB_CATEGORY] = "Crypto"
			    )
			RETURN
			COALESCE(
			    SUMX(
			        transacoes_crypto,
			        VAR data_transacao = FAT_FINANCES[DATE]
			        VAR valor_brl = FAT_FINANCES[EFECTIVE_VALUE] * -1
			        VAR ultima_data_ptax =
			            CALCULATE(
			                MAX(DIM_DOLAR[DATA_HORA]),
			                REMOVEFILTERS(DIM_DOLAR),
			                DIM_DOLAR[DATA_HORA] <= data_transacao
			            )
			        VAR primeira_data_ptax =
			            CALCULATE(
			                MIN(DIM_DOLAR[DATA_HORA]),
			                REMOVEFILTERS(DIM_DOLAR)
			            )
			        VAR data_ref_ptax = COALESCE(ultima_data_ptax, primeira_data_ptax)
			        VAR cotacao_na_data =
			            CALCULATE(
			                MAX(DIM_DOLAR[COTACAO_VENDA]),
			                REMOVEFILTERS(DIM_DOLAR),
			                DIM_DOLAR[DATA_HORA] = data_ref_ptax
			            )
			        RETURN
			            DIVIDE(valor_brl, COALESCE(cotacao_na_data, 5.50), 0)
			    ),
			    0
			)
		formatString: "US$"\ #,0.00;-"US$"\ #,0.00;"US$"\ #,0.00
		displayFolder: crypto
		lineageTag: 9f8e7d6c-5b4a-4321-8765-a1b2c3d4e501

	/// Saldo devedor atual (fatura em aberto) no cartão Inter - Crédito (Compras acumuladas menos Faturas pagas)
	measure fatura_aberta_inter_credito =
			VAR total_compras =
			    CALCULATE(
			        [soma_valor],
			        REMOVEFILTERS(DIM_CALENDARIO),
			        FAT_FINANCES[ACCOUNT] = "Inter - Crédito",
			        FAT_FINANCES[TYPE] = "Despesa"
			    )
			VAR total_pagamentos =
			    CALCULATE(
			        [soma_valor],
			        REMOVEFILTERS(DIM_CALENDARIO),
			        FAT_FINANCES[ACCOUNT] = "Inter - Crédito",
			        FAT_FINANCES[TYPE] = "Receita"
			    )
			RETURN
			    COALESCE(total_compras - total_pagamentos, 0)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: saldos
		lineageTag: 9f8e7d6c-5b4a-4321-8765-a1b2c3d4e502

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Total de entradas provenientes de reembolsos e retornos de empréstimos familiares/terceiros (isolado da renda própria)
	measure reembolsos_emprestimos =
			VAR total_reembolsos =
			    CALCULATE(
			        [soma_valor],
			        FAT_FINANCES[TYPE] = "Receita",
			        FAT_FINANCES[SUB_CATEGORY] = "Retorno - Empréstimos"
			    )
