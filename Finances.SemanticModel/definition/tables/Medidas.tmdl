	/// Valor da fatura mais recente registrada para o cartão Inter - Crédito
	measure ultima_fatura_inter_credito =
			VAR ultima_data_fatura =
			    CALCULATE(
			        MAX(FAT_FINANCES[DATE]),
			        FAT_FINANCES[ACCOUNT] = "Inter - Crédito",
