			    CALCULATE(
			        [soma_valor_efetivo],
			        FAT_FINANCES[ACCOUNT] = "Wise"
			    )
			RETURN
			    saldo
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: saldos
